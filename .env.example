# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=el_access_key_que_copiaste
R2_SECRET_ACCESS_KEY=el_secret_key_que_copiaste
R2_BUCKET_NAME=galaxy-morph
R2_ENDPOINT=https://tu_account_id.r2.cloudflarestorage.com
R2_PRESIGNED_URL_EXPIRY=3600

# Kafka
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_CLIENT_ID=galaxy-morph-api
KAFKA_CONSUMER_GROUP_ID=galaxy-morph-api-group
KAFKA_INGESTION_TOPIC=galaxy.ingestion
KAFKA_RESULTS_TOPIC=galaxy.results
